---
import Layout from '../layouts/Layout.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';

const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://www.ggnagarkar.com';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  name: 'GG Nagarkar professional experience',
  description: 'Professional experience across enterprise AI, cloud and DevOps platforms, and BMC monitoring, observability, log analytics, and ITSM products.',
  url: `${site}/experience`
};
---
<Layout
  title="Experience | GG Nagarkar"
  description="Professional experience of GG Nagarkar across founding, enterprise AI, DevOps, cloud platforms, and BMC monitoring, observability, log analytics, and ITSM work."
  canonicalPath="/experience"
  jsonLd={jsonLd}
  breadcrumbs={[
    { name: 'Home', item: `${site}/` },
    { name: 'Experience', item: `${site}/experience` }
  ]}
>
  <h1 class="mb-4 text-3xl font-semibold text-slate-900">Experience</h1>
  <ExperienceTimeline />
</Layout>
